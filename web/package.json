{
  "name": "oanh-accounting-web",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "corepack pnpm build && playwright test --config=playwright.live.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "antd": "6.6.7",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
